# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจาก Firebase Console ของโปรเจกต์ตนเอง
# หากไม่กรอกค่าเหล่านี้ ระบบจะทำงานใน "โหมดทดลอง" อัตโนมัติ (ข้อมูลสังเคราะห์ในหน่วยความจำ ไม่เชื่อมต่อ Firebase)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL ของ Cloud Functions API เมื่อรันแยกจาก Hosting (ปกติปล่อยว่างไว้ ใช้ /api ผ่าน Hosting rewrite)
VITE_API_BASE_URL=
